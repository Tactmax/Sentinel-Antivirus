<UserControl x:Class="Sentinel.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="2,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
                <TextBlock Text="Scan history" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Every scan Sentinel runs is recorded here, even after a restart."
                           Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Delete selected" Click="Delete_Click"/>
                <Button Content="Clear all history" Style="{StaticResource DangerButton}" Click="ClearAll_Click" Margin="9,0,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Session list -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Scans" FontSize="15" FontWeight="SemiBold" Margin="2,0,0,10"/>
                    <Grid Grid.Row="1">
                        <DataGrid x:Name="SessionsGrid" ItemsSource="{Binding Sessions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  SelectionChanged="SessionsGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="When" Binding="{Binding StartedLocal}" Width="125"/>
                                <DataGridTextColumn Header="Result" Binding="{Binding OutcomeLabel}" Width="105"/>
                                <DataGridTextColumn Header="Files" Binding="{Binding ScannedFileCount}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="EmptyHint" Grid.Row="0" Text="No scans recorded yet."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0" Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Detail -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="2,0,2,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock x:Name="DetailTitle" Text="Select a scan" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DetailSubtitle" Text="" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="RescanButton" Content="Rescan this target" Click="Rescan_Click"
                                VerticalAlignment="Center" IsEnabled="False"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <DataGrid x:Name="DetailGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Threat" Binding="{Binding Threat}" Width="210"/>
                                <DataGridTextColumn Header="File" Binding="{Binding Path}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource PathCell}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256Short}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel x:Name="DetailEmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource IconShield}" Stroke="{StaticResource MutedBrush}"
                                  Width="32" Height="32" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="DetailEmptyText" Text="This scan found nothing." FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Expander x:Name="WarningsExpander" Grid.Row="2" Header="Warnings" Margin="0,10,0,0"
                              Foreground="{StaticResource MutedBrush}" Visibility="Collapsed">
                        <TextBox x:Name="WarningsBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="150"
                                 Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                                 Padding="0"/>
                    </Expander>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
