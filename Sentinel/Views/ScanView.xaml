<UserControl x:Class="Sentinel.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sentinel">
    <UserControl.Resources>
        <local:KindToBrushConverter x:Key="KindToBrush"/>
    </UserControl.Resources>

    <Grid AllowDrop="True" Drop="Root_Drop" DragOver="Root_DragOver">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="2,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Scan" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Point Sentinel at a file or folder. Large folders are scanned in parallel for speed."
                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="UpdateDefsButton" Content="Update definitions"
                    VerticalAlignment="Center" Click="UpdateDefs_Click"
                    ToolTip="Download the latest ClamAV signatures"/>
        </Grid>

        <!-- Target + progress -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Target input -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Scan target" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBox x:Name="TargetBox" Margin="0,6,0,0" KeyDown="TargetBox_KeyDown"
                                 Tag="Type a file or folder path, or drop one anywhere on this screen"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Browse files…" Click="ChooseFile_Click" Margin="0,0,9,0" VerticalAlignment="Bottom"/>
                    <Button Grid.Column="2" Content="Browse folder…" Click="ChooseFolder_Click" VerticalAlignment="Bottom"/>
                </Grid>

                <!-- Actions + engine chip -->
                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ScanButton" Style="{StaticResource AccentButton}" Content="Scan target"
                            Click="Scan_Click" MinWidth="140" ToolTip="Scan the file or folder typed above"/>
                    <Button Grid.Column="1" Content="Quick scan" Click="QuickScan_Click" Margin="9,0,0,0"
                            ToolTip="Downloads, Desktop and Documents — the folders malware most often lands in"/>
                    <Button Grid.Column="2" Content="Full scan (C:)" Click="FullScan_Click" Margin="9,0,0,0"
                            ToolTip="Everything on the C: drive — slow, but thorough"/>
                    <Border Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource Badge}" Background="{StaticResource InputBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="11,5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="EngineDot" Width="7" Height="7" VerticalAlignment="Center"
                                     Margin="0,0,8,0" Fill="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="EngineLabel" Text="No engine" FontSize="11.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Engine hint -->
                <TextBlock x:Name="EngineHint" Grid.Row="2" Margin="0,10,0,0" FontSize="11.5" TextWrapping="Wrap"
                           Text="Each scan loads the signature database again, which takes about a minute."/>

                <!-- Progress -->
                <StackPanel x:Name="ProgressPanel" Grid.Row="3" Margin="0,18,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="ScanProgress" Minimum="0" Maximum="100" Height="8" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ScanPercentText" Grid.Column="1" Text="" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" Width="48"/>
                        <TextBlock x:Name="SpeedText" Grid.Column="2" Text="" Foreground="{StaticResource MutedBrush}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" Width="92"/>
                        <TextBlock x:Name="ElapsedText" Grid.Column="3" Text="" Foreground="{StaticResource MutedBrush}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" Width="64"/>
                        <Button x:Name="CancelButton" Grid.Column="4" Content="Cancel" Style="{StaticResource DangerButton}"
                                Click="CancelScan_Click" Margin="12,0,0,0"/>
                    </Grid>
                </StackPanel>

                <TextBlock x:Name="ScanStatusText" Grid.Row="4" Text="Ready. Choose a target, or use Quick scan."
                           Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- Results -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="2,0,2,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Scan results" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ResultsSummary" Text="Run a scan to see results here."
                                   Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="QuarantineSelectedButton" Content="Quarantine selected"
                            Click="QuarantineSelected_Click" IsEnabled="False"/>
                    <Button Grid.Column="2" x:Name="QuarantineAllButton" Content="Quarantine all"
                            Click="QuarantineAll_Click" IsEnabled="False" Margin="9,0,0,0"/>
                    <Button Grid.Column="3" Content="Open location" Click="OpenLocation_Click" Margin="9,0,0,0"/>
                    <Button Grid.Column="4" Content="Clear" Click="ClearResults_Click" Margin="9,0,0,0"/>
                </Grid>

                <Grid Grid.Row="1">
                    <DataGrid x:Name="ResultsGrid"
                              ItemsSource="{Binding Results, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectionChanged="ResultsGrid_SelectionChanged" MouseDoubleClick="ResultsGrid_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Status" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold"
                                                   Foreground="{Binding Kind, Converter={StaticResource KindToBrush}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Detection" Binding="{Binding Threat}" Width="220"/>
                            <DataGridTextColumn Header="File path" Binding="{Binding Path}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PathCell}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256Short}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="ResultsEmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconShield}" Stroke="{StaticResource MutedBrush}"
                              Width="34" Height="34" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ResultsEmptyTitle" Text="Nothing scanned yet" FontSize="15"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock x:Name="ResultsEmptyText" Text="Run a scan above — results appear here as soon as the engine finds something."
                                   Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
