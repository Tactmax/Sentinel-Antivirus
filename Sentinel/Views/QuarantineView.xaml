<UserControl x:Class="Sentinel.Views.QuarantineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="2,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
                <TextBlock Text="Quarantine" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Detected files are stored here encrypted with a key tied to your Windows account. Restoring returns the file to a location you choose."
                           Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,4,0,0" MaxWidth="700" TextWrapping="Wrap"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" MaxWidth="560">
                <Button Content="Restore…" Click="Restore_Click"/>
                <Button Content="Verify integrity" Click="Verify_Click" Margin="9,0,0,0"/>
                <Button Content="Open folder" Click="OpenFolder_Click" Margin="9,0,0,0"/>
                <Button Content="Refresh" Click="Refresh_Click" Margin="9,0,0,0"/>
                <Button Content="Delete" Style="{StaticResource DangerButton}" Click="Delete_Click" Margin="9,0,0,0"/>
            </WrapPanel>
        </Grid>

        <!-- List -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16">
            <Grid>
                <DataGrid x:Name="EntriesGrid" ItemsSource="{Binding Entries, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Threat" Binding="{Binding Threat}" Width="210"/>
                        <DataGridTextColumn Header="Original file" Binding="{Binding OriginalPath}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PathCell}"/>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="80"/>
                        <DataGridTextColumn Header="Quarantined" Binding="{Binding QuarantinedLocal}" Width="140"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="180"/>
                        <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256Short}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconQuarantine}" Stroke="{StaticResource MutedBrush}"
                          Width="36" Height="36" HorizontalAlignment="Center"/>
                    <TextBlock Text="Quarantine is empty" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    <TextBlock Text="Nothing has been quarantined. Files you quarantine from a scan appear here."
                               Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="Never restore a file you are not sure about. If a restore is a false positive, keep the file only where you intended it to live, and consider submitting the hash to a multi-engine scanner."
                   Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="2,12,2,0" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
