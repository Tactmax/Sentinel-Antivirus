<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Sentinel</AssemblyName>
    <RootNamespace>Sentinel</RootNamespace>
    <Version>1.3.0</Version>
    <Product>Sentinel Antivirus</Product>
    <Company>Sentinel</Company>
    <Description>Windows malware scanner powered by ClamAV</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\sentinel.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\sentinel.ico" />
  </ItemGroup>
</Project>
