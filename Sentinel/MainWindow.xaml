<Window x:Class="Sentinel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Sentinel.Views"
        Title="Sentinel Antivirus"
        Height="720" Width="1200"
        MinHeight="560" MinWidth="880"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/Sentinel;component/Resources/sentinel.ico">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,20">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Sentinel;component/Resources/sentinel.ico" Width="30" Height="30"/>
                        <TextBlock Text="SENTINEL" FontSize="19" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="11,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="On-demand malware scanner" Foreground="{StaticResource MutedBrush}"
                               FontSize="11.5" Margin="41,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel DockPanel.Dock="Top" Margin="12,0,12,0">
                    <RadioButton x:Name="NavDashboard" GroupName="Nav" Style="{StaticResource NavItem}"
                                 IsChecked="True" Click="Nav_Click" Tag="dashboard">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconDashboard}"/>
                            <TextBlock Text="Dashboard" Margin="13,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavScan" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Click="Nav_Click" Tag="scan">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconScan}"/>
                            <TextBlock Text="Scan" Margin="13,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavThreats" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Click="Nav_Click" Tag="results">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconThreat}"/>
                            <TextBlock Text="Threats" Margin="13,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavQuarantine" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Click="Nav_Click" Tag="quarantine">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconQuarantine}"/>
                            <TextBlock Text="Quarantine" Margin="13,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavHistory" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Click="Nav_Click" Tag="history">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconHistory}"/>
                            <TextBlock Text="History" Margin="13,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource NavItem}"
                                 Click="Nav_Click" Tag="settings">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Data="{StaticResource IconSettings}"/>
                            <TextBlock Text="Settings" Margin="13,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Engine status -->
                <Border DockPanel.Dock="Bottom" Margin="14,0,14,16" CornerRadius="9"
                        Background="#101E19" BorderBrush="{StaticResource AccentDimBrush}" BorderThickness="1" Padding="13">
                    <StackPanel>
                        <TextBlock Text="ENGINE" Foreground="{StaticResource AccentBrush}" FontSize="10"
                                   FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <Ellipse x:Name="SidebarStatusDot" Width="8" Height="8" VerticalAlignment="Center"
                                     Margin="0,0,8,0" Fill="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="SidebarEngineText" Text="Engine not configured"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Style="{StaticResource Divider}" Margin="0,11,0,9"/>
                        <TextBlock Text="Keep Microsoft Defender enabled." Foreground="{StaticResource MutedBrush}"
                                   FontSize="10.5" TextWrapping="Wrap"/>
                        <TextBlock Text="Sentinel 1.3.0" Foreground="{StaticResource MutedBrush}"
                                   FontSize="10.5" Margin="0,6,0,0" Opacity="0.6"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- ================= Main content ================= -->
        <Grid Grid.Column="1" Margin="26,22,26,22">
            <views:DashboardView x:Name="DashboardView"/>
            <views:ScanView x:Name="ScanView" Visibility="Collapsed"/>
            <views:ResultsView x:Name="ResultsView" Visibility="Collapsed"/>
            <views:QuarantineView x:Name="QuarantineView" Visibility="Collapsed"/>
            <views:HistoryView x:Name="HistoryView" Visibility="Collapsed"/>
            <views:SettingsView x:Name="SettingsView" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
