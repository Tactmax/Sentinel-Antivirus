<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Sentinel.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Sentinel\Sentinel.csproj" />
    <ProjectReference Include="..\Sentinel.StubEngine\Sentinel.StubEngine.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>
  <!--
    ReferenceOutputAssembly="false" only brings over the stub's apphost .exe, which is useless
    without its managed dll. Pull the whole stub build output next to the test binary so the
    suite can launch the stub engine directly.
  -->
  <Target Name="CopyStubEngineOutput" AfterTargets="Build">
    <ItemGroup>
      <StubEngineFiles Include="$(MSBuildThisFileDirectory)..\Sentinel.StubEngine\bin\$(Configuration)\net10.0\Sentinel.StubEngine.*" />
    </ItemGroup>
    <Copy SourceFiles="@(StubEngineFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
